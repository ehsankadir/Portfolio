---
import Base from '../../layouts/Base.astro';
import Empty from '../../components/Empty.astro';
import { sortedPosts, fmtDate, readingMinutes } from '../../lib/content';

const posts = await sortedPosts();
---

<Base
  title="Writing"
  description="Notes, articles and breakdowns on engineering practice, systems and the things that broke."
>
  <div class="shell page">
    <p class="meta">Index · Writing</p>
    <h1 class="page__title">Notes, newest first.</h1>

    {posts.length ? (
      <ol class="index">
        {posts.map((post, i) => (
          <li class="row" data-reveal={i}>
            <a href={`/writing/${post.id}`} class="post">
              <span class="post__side">
                <span class="record">{post.data.record}</span>
                <span class="meta post__date">{fmtDate(post.data.published)}</span>
                <span class="meta">{post.data.kind} · {readingMinutes(post.body ?? '')} min</span>
              </span>
              <span class="post__main">
                <h2 class="row__title">{post.data.title}</h2>
                <span class="post__summary">{post.data.summary}</span>
                {post.data.tags.length > 0 && (
                  <span class="post__tags">
                    {post.data.tags.map((t) => <span class="tag meta">{t}</span>)}
                  </span>
                )}
              </span>
            </a>
          </li>
        ))}
      </ol>
    ) : (
      <Empty line="Nothing published yet. Add a markdown file to src/content/posts and it will appear here." />
    )}
  </div>
</Base>

<style>
  .page {
    padding-block: 3rem 2rem;
  }
  .page__title {
    font-size: var(--size-title);
    margin-top: 1.25rem;
  }
  .index {
    margin-top: 3rem;
  }
  .post {
    display: grid;
    gap: 0.5rem 2.5rem;
    padding-block: 1.75rem;
  }
  .post__side {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .post__date {
    color: var(--ink);
  }
  .post__summary {
    display: block;
    margin-top: 0.5rem;
    font-size: var(--size-small);
    color: var(--ink-muted);
    max-width: 58ch;
    text-wrap: pretty;
  }
  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.875rem;
  }
  .tag {
    border: 1px solid var(--hairline);
    padding: 0.15rem 0.4rem;
    line-height: 1.3;
  }
  @media (min-width: 56rem) {
    .post {
      grid-template-columns: 11rem minmax(0, 1fr);
    }
    .post__side {
      display: grid;
      gap: 0.3rem;
      align-content: start;
    }
  }
  @media (min-width: 48rem) {
    .page {
      padding-block: 5rem 2rem;
    }
  }
</style>
