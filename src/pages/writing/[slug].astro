---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { sortedPosts, fmtDate, readingMinutes, type PostEntry } from '../../lib/content';
import { profile } from '../../data/profile';

export async function getStaticPaths() {
  const posts = await sortedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

type Props = { post: PostEntry };
const { post } = Astro.props as Props;
const { Content } = await render(post);
const d = post.data;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.summary,
  datePublished: d.published.toISOString(),
  dateModified: (d.updated ?? d.published).toISOString(),
  keywords: d.tags.join(', '),
  author: { '@type': 'Person', name: profile.name },
});
---

<Base title={d.title} description={d.summary} type="article" jsonLd={jsonLd}>
  <article class="shell entry">
    <header class="measure">
      <p class="meta">{d.kind} · {d.record}</p>
      <h1 class="entry__title">{d.title}</h1>
      <p class="lead entry__summary">{d.summary}</p>
      <div class="entry__bar">
        <span class="meta">
          {fmtDate(d.published)} · {readingMinutes(post.body ?? '')} min read
          {d.updated && <> · updated {fmtDate(d.updated)}</>}
        </span>
        {d.tags.length > 0 && (
          <span class="entry__tags">
            {d.tags.map((t) => <span class="tag meta">{t}</span>)}
          </span>
        )}
      </div>
    </header>

    <div class="prose entry__prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .entry {
    padding-block: 3rem 0;
  }
  .entry__title {
    font-size: var(--size-title);
    margin-top: 1.25rem;
  }
  .entry__summary {
    margin-top: 1.25rem;
  }
  .entry__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--hairline);
    margin-top: 2rem;
    padding-top: 1rem;
  }
  .entry__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tag {
    border: 1px solid var(--hairline);
    padding: 0.15rem 0.4rem;
    line-height: 1.3;
  }
  .entry__prose {
    margin-top: 2.75rem;
  }
  @media (min-width: 48rem) {
    .entry {
      padding-block: 5rem 0;
    }
  }
</style>
